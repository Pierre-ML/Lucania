# Ces variables sont OPTIONNELLES.
# Elles servent uniquement à créer la première connexion au premier lancement.
# Ensuite, tout se règle dans la page Paramètres de l'application.

# Adresse du serveur Ollama
OLLAMA_URL=http://localhost:11434
# Exemple pour un serveur joignable via WireGuard :
# OLLAMA_URL=http://10.0.0.2:11434

# Modèles à ajouter manuellement, séparés par des virgules.
# Laisser vide pour la détection automatique.
OLLAMA_MODELS=

# Extinction à distance (optionnelle, désactivée si vide)
SHUTDOWN_URL=
SHUTDOWN_METHOD=GET
SHUTDOWN_TOKEN=

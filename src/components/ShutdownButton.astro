---
import { getLang, t } from '../i18n/index';
const lang = getLang(Astro);
---
<div id="shutdown-zone" class="mt-2 hidden border-t border-border bg-black/30 p-4">
	<div id="shutdown-list" class="flex flex-col gap-2"></div>
</div>

<dialog id="shutdown-dialog" class="backdrop:bg-black/70 backdrop:backdrop-blur-sm m-auto w-[min(26rem,calc(100vw-2rem))] rounded-2xl border border-border bg-surface p-6 text-fg shadow-[0_24px_80px_-12px_rgb(0_0_0/0.8)]">
	<h2 id="shutdown-title" class="font-serif text-xl">{t(lang, 'chat.shutdown.defaultTitle')}</h2>
	<p id="shutdown-text" class="mt-3 text-sm leading-relaxed text-muted">{t(lang, 'chat.shutdown.defaultText')}</p>
	<p id="shutdown-message" class="mt-3 min-h-5 text-sm text-muted"></p>
	<div class="mt-5 flex justify-end gap-2">
		<button id="shutdown-cancel" type="button" autofocus class="rounded-lg border border-border px-4 py-2 text-sm text-fg transition-colors hover:bg-white/5">{t(lang, 'common.cancel')}</button>
		<button id="shutdown-confirm" type="button" class="rounded-lg bg-danger px-4 py-2 text-sm font-medium text-black transition-opacity hover:opacity-90 disabled:opacity-50">{t(lang, 'chat.shutdown.confirm')}</button>
	</div>
</dialog>

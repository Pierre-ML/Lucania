---
import PlusIcon from '../assets/icons/plus.svg';
import FolderPlusIcon from '../assets/icons/folder-plus.svg';
import SettingsIcon from '../assets/icons/settings.svg';
import ShutdownButton from './ShutdownButton.astro';
import { getLang, t } from '../i18n/index';
const lang = getLang(Astro);
---
<div id="sidebar-backdrop" class="fixed inset-0 z-30 hidden bg-black/70 backdrop-blur-[2px] data-[open=true]:block md:hidden!"></div>
<aside id="sidebar" class="fixed inset-y-0 left-0 z-40 w-64 shrink-0 -translate-x-full overflow-hidden border-r border-border bg-sidebar data-[open=true]:translate-x-0 md:static md:translate-x-0 transition-[width,transform,visibility] duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] motion-reduce:transition-none md:data-[collapsed=true]:invisible md:data-[collapsed=true]:w-0 md:data-[collapsed=true]:border-r-0">
	<div class="flex h-full w-64 flex-col">
		<div class="flex flex-col gap-3 p-4 pb-2">
			<div class="flex h-9 items-center gap-2 px-1.5 text-fg">
				<svg viewBox="0 0 64 64" fill="none" class="size-6 shrink-0" aria-hidden="true" focusable="false">
					<path d="M14 4L26 22L14 34Z" fill="currentColor" fill-opacity="0.7"/>
					<path d="M50 4L38 22L50 34Z" fill="currentColor" fill-opacity="0.45"/>
					<path d="M26 22L38 22L32 36Z" fill="currentColor"/>
					<path d="M14 34L26 22L32 36Z" fill="currentColor" fill-opacity="0.5"/>
					<path d="M50 34L38 22L32 36Z" fill="currentColor" fill-opacity="0.3"/>
					<path d="M14 34L32 36L32 60Z" fill="currentColor" fill-opacity="0.3"/>
					<path d="M50 34L32 36L32 60Z" fill="currentColor" fill-opacity="0.2"/>
				</svg>
				<span class="font-serif text-lg font-semibold tracking-tight">Lucania</span>
			</div>
			<div class="flex items-center gap-1">
				<button id="new-chat-btn" type="button" class="group flex min-w-0 flex-1 cursor-pointer items-center gap-2 rounded-md px-2 py-1.5 text-[13px] text-muted transition-colors duration-200 hover:bg-white/5 hover:text-fg focus-visible:outline-2">
					<span class="flex size-4.5 shrink-0 items-center justify-center rounded-full bg-white/5 text-muted transition-colors group-hover:text-fg"><PlusIcon width="14" height="14" aria-hidden="true" /></span>
					{t(lang, 'chat.sidebar.newChat')}
				</button>
				<button id="new-folder-btn" type="button" aria-label={t(lang, 'chat.sidebar.newFolder')} title={t(lang, 'chat.sidebar.newFolder')} class="group flex size-8 shrink-0 cursor-pointer items-center justify-center rounded-md text-muted transition-colors duration-200 hover:bg-white/5 hover:text-fg focus-visible:outline-2">
					<FolderPlusIcon width="19" height="19" aria-hidden="true" />
				</button>
			</div>
		</div>
		<nav class="min-h-0 flex-1 overflow-y-auto px-3 pb-3" aria-label={t(lang, 'chat.sidebar.conversations')}>
			<ul id="conversation-list" class="flex flex-col gap-0.5"></ul>
		</nav>
		<div class="px-3 pb-2 pt-1">
			<a href="/parametres" class="group flex items-center gap-2 rounded-md px-2 py-1.5 text-[13px] text-muted transition-colors duration-200 hover:bg-white/5 hover:text-fg focus-visible:outline-2">
				<span class="flex size-4.5 shrink-0 items-center justify-center text-muted transition-colors group-hover:text-fg"><SettingsIcon width="16" height="16" aria-hidden="true" /></span>
				{t(lang, 'chat.sidebar.settings')}
			</a>
		</div>
		<ShutdownButton />
	</div>
</aside>
<script is:inline>
	try {
		if (window.innerWidth >= 768 && localStorage.getItem('sidebarCollapsed') === '1') {
			document.getElementById('sidebar').setAttribute('data-collapsed', 'true');
			var t = document.getElementById('sidebar-toggle');
			if (t) t.setAttribute('aria-expanded', 'false');
		}
	} catch (e) {}
</script>

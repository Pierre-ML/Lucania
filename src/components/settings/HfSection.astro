---
import { getLang, t } from '../../i18n/index';

const secondaryBtn = 'inline-flex h-9 shrink-0 cursor-pointer items-center justify-center rounded-lg border border-border px-4 text-sm font-medium text-fg transition-[background-color,transform] duration-150 hover:bg-fg/5 focus-visible:outline-fg/40 active:scale-[0.97] disabled:cursor-not-allowed disabled:opacity-50 motion-reduce:transition-none';
const primaryBtn = 'inline-flex h-10 shrink-0 cursor-pointer items-center justify-center gap-1.5 rounded-lg bg-fg px-4 text-sm font-medium text-bg transition-[background-color,transform] duration-150 hover:bg-fg/90 focus-visible:outline-fg/40 active:scale-[0.97] disabled:cursor-not-allowed disabled:opacity-50 motion-reduce:transition-none';
const smallBtn = 'inline-flex h-8 shrink-0 cursor-pointer items-center justify-center rounded-lg border border-border px-3 text-xs font-medium text-fg transition-[background-color,transform] duration-150 hover:bg-fg/5 focus-visible:outline-fg/40 active:scale-[0.97] disabled:cursor-not-allowed disabled:opacity-50 motion-reduce:transition-none';
const smallPrimaryBtn = 'inline-flex h-8 shrink-0 cursor-pointer items-center justify-center rounded-lg bg-fg px-3 text-xs font-medium text-bg transition-[background-color,transform] duration-150 hover:bg-fg/90 focus-visible:outline-fg/40 active:scale-[0.97] disabled:cursor-not-allowed disabled:opacity-50 motion-reduce:transition-none';
const smallDangerBtn = 'inline-flex h-8 shrink-0 cursor-pointer items-center justify-center rounded-lg border border-danger/40 px-3 text-xs font-medium text-danger transition-[background-color,transform] duration-150 hover:bg-fg/5 focus-visible:outline-fg/40 active:scale-[0.97] disabled:cursor-not-allowed disabled:opacity-50 motion-reduce:transition-none';
const input = 'h-10 w-full rounded-lg border border-border bg-transparent px-3 text-sm text-fg transition-colors duration-150 placeholder:text-muted/60 hover:border-fg/20 focus:border-fg/40 focus-visible:outline-2 focus-visible:outline-fg/20 focus-visible:outline-offset-0 aria-invalid:border-danger/60';
const lang = getLang(Astro);
---
<section aria-labelledby="hf-title">
	<h2 id="hf-title" class="text-lg font-medium tracking-tight">{t(lang, 'settings.hf.title')}</h2>
	<p class="mt-1 text-sm text-muted">{t(lang, 'settings.hf.description')}</p>

	<p id="hf-unavailable" hidden class="mt-6 rounded-xl border border-dashed border-border px-6 py-10 text-center text-sm text-muted"></p>
	<p id="hf-error" role="status" aria-live="polite" hidden class="mt-4 rounded-lg border border-danger/40 px-3 py-2 text-xs text-danger"></p>

	<div id="hf-main" hidden class="mt-6 space-y-8">
		<div id="hf-downloads-wrap" hidden>
			<h3 class="text-sm font-medium">{t(lang, 'settings.hf.downloads.title')}</h3>
			<ul id="hf-downloads" class="mt-3 divide-y divide-border rounded-xl border border-border"></ul>
		</div>

		<div>
			<h3 class="text-sm font-medium">{t(lang, 'settings.hf.token.title')}</h3>
			<p id="hf-token-status" class="mt-1 text-sm text-muted"></p>
			<form id="hf-token-form" novalidate class="mt-3 flex gap-2">
				<label for="hf-token-input" class="sr-only">{t(lang, 'settings.hf.token.label')}</label>
				<input id="hf-token-input" type="password" autocomplete="new-password" spellcheck="false" placeholder={t(lang, 'settings.hf.token.placeholder')} class={`${input} font-mono`} />
				<button type="submit" id="hf-token-save" class={primaryBtn}>{t(lang, 'settings.hf.token.save')}</button>
				<button type="button" id="hf-token-clear" hidden class={secondaryBtn + ' h-10'}>{t(lang, 'settings.hf.token.clear')}</button>
			</form>
			<p class="mt-2 text-xs text-muted">
				{t(lang, 'settings.hf.token.help')}
				<button type="button" id="hf-token-link" class="cursor-pointer rounded text-fg underline decoration-fg/30 underline-offset-2 transition-colors duration-150 hover:decoration-fg focus-visible:outline-fg/40">{t(lang, 'settings.hf.token.link')}</button>
			</p>
		</div>

		<div>
			<h3 class="text-sm font-medium">{t(lang, 'settings.hf.search.title')}</h3>
			<form id="hf-search-form" role="search" class="mt-3 flex gap-2">
				<label for="hf-search-input" class="sr-only">{t(lang, 'settings.hf.search.label')}</label>
				<input id="hf-search-input" type="search" autocomplete="off" spellcheck="false" placeholder={t(lang, 'settings.hf.search.placeholder')} class={input} />
				<button type="submit" id="hf-search-btn" class={primaryBtn}>{t(lang, 'settings.hf.search.button')}</button>
			</form>
			<p id="hf-search-status" role="status" aria-live="polite" class="mt-3 text-sm text-muted"></p>
			<ul id="hf-results" hidden class="mt-3 divide-y divide-border rounded-xl border border-border"></ul>
			<p id="hf-results-empty" hidden class="mt-3 rounded-xl border border-dashed border-border px-6 py-8 text-center text-sm text-muted">{t(lang, 'settings.hf.search.empty')}</p>
		</div>
	</div>

	<template id="tpl-hf-download">
		<li data-dl class="space-y-2 px-4 py-3">
			<div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2">
				<div class="min-w-0 flex-1">
					<p data-dl-name class="truncate font-mono text-sm"></p>
					<p data-dl-repo class="truncate text-xs text-muted"></p>
				</div>
				<div class="flex shrink-0 items-center gap-2">
					<button type="button" data-dl-use hidden class={smallPrimaryBtn}>{t(lang, 'settings.hf.downloads.use')}</button>
					<button type="button" data-dl-pause hidden class={smallBtn}>{t(lang, 'settings.hf.downloads.pause')}</button>
					<button type="button" data-dl-resume hidden class={smallBtn}>{t(lang, 'settings.hf.downloads.resume')}</button>
					<button type="button" data-dl-cancel hidden class={smallDangerBtn}>{t(lang, 'settings.hf.downloads.cancel')}</button>
				</div>
			</div>
			<progress data-dl-bar class="progress h-1.5 w-full text-fg" value="0" max="100"></progress>
			<div class="flex flex-wrap justify-between gap-x-4 gap-y-1 text-xs text-muted">
				<span data-dl-bytes></span>
				<span data-dl-state></span>
			</div>
			<p data-dl-error hidden class="text-xs text-danger"></p>
		</li>
	</template>
</section>

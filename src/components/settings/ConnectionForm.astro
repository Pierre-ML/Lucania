---
import { getLang, t } from '../../i18n/index';
import Switch from './Switch.astro';

const input = 'h-10 w-full rounded-lg border border-border bg-transparent px-3 text-sm text-fg transition-colors duration-150 placeholder:text-muted/60 hover:border-fg/20 focus:border-fg/40 focus-visible:outline-2 focus-visible:outline-fg/20 focus-visible:outline-offset-0 aria-invalid:border-danger/60';
const label = 'mb-1.5 block text-sm font-medium';
const help = 'mt-1.5 text-xs text-muted';
const err = 'mt-1.5 text-xs text-danger';
const primaryBtn = 'inline-flex h-9 shrink-0 cursor-pointer items-center justify-center rounded-lg bg-fg px-4 text-sm font-medium text-bg transition-[background-color,transform] duration-150 hover:bg-fg/90 focus-visible:outline-fg/40 active:scale-[0.97] disabled:cursor-not-allowed disabled:opacity-50 motion-reduce:transition-none';
const ghostBtn = 'inline-flex cursor-pointer items-center rounded-md text-sm text-muted transition-colors duration-150 hover:text-fg focus-visible:outline-fg/40';
const lang = getLang(Astro);
---
<dialog id="connection-dialog" aria-labelledby="cf-title" class="m-auto max-h-none w-[min(28rem,calc(100vw-2rem))] max-w-md overflow-hidden rounded-2xl border border-border bg-surface p-0 text-fg open:animate-pop-in backdrop:bg-black/70 motion-reduce:animate-none">
	<form id="connection-form" novalidate class="flex max-h-[calc(100dvh-2rem)] flex-col">
		<header class="px-6 pb-4 pt-5">
			<h2 id="cf-title" class="font-serif text-xl">{t(lang, 'settings.form.titleAdd')}</h2>
		</header>

		<div class="flex-1 space-y-5 overflow-y-auto px-6 pb-5">
			<div>
				<label for="cf-name" class={label}>{t(lang, 'settings.form.name.label')}</label>
				<input id="cf-name" name="name" type="text" maxlength="80" autocomplete="off" data-field="name" class={input} aria-describedby="cf-name-error" />
				<p id="cf-name-error" data-error-for="name" hidden class={err}></p>
			</div>

			<div>
				<label for="cf-kind" class={label}>{t(lang, 'settings.form.kind.label')}</label>
				<select id="cf-kind" class={`${input} [&>option]:bg-surface`}>
					<option value="local">{t(lang, 'settings.form.kind.local')}</option>
					<option value="remote">{t(lang, 'settings.form.kind.remote')}</option>
				</select>
			</div>

			<div class="space-y-4 border-t border-border pt-4">
				<div class="flex items-center justify-between gap-4">
					<div class="min-w-0">
						<p id="cf-sd-label" class="text-sm font-medium">{t(lang, 'settings.form.shutdown.label')}</p>
						<p class={help}>{t(lang, 'settings.form.shutdown.help')}</p>
					</div>
					<Switch id="cf-sd-enabled" labelledby="cf-sd-label" />
				</div>
				<div id="cf-sd-fields" hidden class="space-y-4">
					<div>
						<label for="cf-sd-url" class={label}>{t(lang, 'settings.form.shutdown.url')}</label>
						<input id="cf-sd-url" data-field="shutdownUrl" type="url" inputmode="url" autocomplete="off" spellcheck="false" placeholder="http://10.0.0.2:9000/shutdown" class={`${input} font-mono`} aria-describedby="cf-sd-url-error" />
						<p id="cf-sd-url-error" data-error-for="shutdownUrl" hidden class={err}></p>
					</div>
					<div>
						<label for="cf-sd-method" class={label}>{t(lang, 'settings.form.shutdown.method')}</label>
						<select id="cf-sd-method" class={`${input} [&>option]:bg-surface`}>
							<option value="POST">POST</option>
							<option value="GET">GET</option>
						</select>
					</div>
					<div>
						<label for="cf-sd-token" class={label}>{t(lang, 'settings.form.shutdown.token')}</label>
						<input id="cf-sd-token" type="password" autocomplete="new-password" class={input} />
						<label id="cf-sd-clear-wrap" hidden class="mt-2 flex cursor-pointer items-center gap-2 text-xs text-muted">
							<input id="cf-sd-clear" type="checkbox" class="size-4 accent-fg" />
							{t(lang, 'settings.form.shutdown.tokenClear')}
						</label>
					</div>
				</div>
			</div>
		</div>

		<p id="cf-error" role="alert" hidden class="px-6 pb-3 text-xs text-danger"></p>

		<footer class="flex justify-end gap-2 border-t border-border px-6 py-4">
			<button type="button" data-action="cancel" class={ghostBtn + ' h-9 px-3'}>{t(lang, 'settings.form.cancel')}</button>
			<button type="submit" id="cf-save" class={primaryBtn}><span id="cf-save-label">{t(lang, 'settings.form.add')}</span></button>
		</footer>
	</form>
</dialog>

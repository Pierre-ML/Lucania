---
import { getLang, t } from '../../i18n/index';

const secondaryBtn = 'inline-flex h-9 shrink-0 cursor-pointer items-center justify-center rounded-lg border border-border px-4 text-sm font-medium text-fg transition-[background-color,transform] duration-150 hover:bg-fg/5 focus-visible:outline-fg/40 active:scale-[0.97] disabled:cursor-not-allowed disabled:opacity-50 motion-reduce:transition-none';
const primaryBtn = 'inline-flex h-9 shrink-0 cursor-pointer items-center justify-center rounded-lg bg-fg px-4 text-sm font-medium text-bg transition-[background-color,transform] duration-150 hover:bg-fg/90 focus-visible:outline-fg/40 active:scale-[0.97] disabled:cursor-not-allowed disabled:opacity-50 motion-reduce:transition-none';
const input = 'h-10 w-full rounded-lg border border-border bg-transparent px-3 text-sm text-fg transition-colors duration-150 placeholder:text-muted/60 hover:border-fg/20 focus:border-fg/40 focus-visible:outline-2 focus-visible:outline-fg/20 focus-visible:outline-offset-0';
const label = 'mb-1.5 block text-sm font-medium';
const lang = getLang(Astro);
---
<section aria-labelledby="engine-title">
	<div class="flex items-start justify-between gap-4">
		<div class="min-w-0">
			<h2 id="engine-title" class="text-lg font-medium tracking-tight">{t(lang, 'settings.engine.title')}</h2>
			<p class="mt-1 text-sm text-muted">{t(lang, 'settings.engine.description')}</p>
		</div>
		<button type="button" id="engine-refresh" class={secondaryBtn}>{t(lang, 'settings.engine.refresh')}</button>
	</div>

	<p id="engine-unavailable" hidden class="mt-6 rounded-xl border border-dashed border-border px-6 py-10 text-center text-sm text-muted"></p>
	<p id="engine-error" role="status" aria-live="polite" hidden class="mt-4 rounded-lg border border-danger/40 px-3 py-2 text-xs text-danger"></p>

	<div id="engine-info" hidden>
		<dl class="mt-6 divide-y divide-border rounded-xl border border-border text-sm">
			<div class="flex items-center justify-between gap-4 px-4 py-3">
				<dt class="text-muted">{t(lang, 'settings.engine.backend')}</dt>
				<dd id="engine-backend" class="font-medium"></dd>
			</div>
			<div class="flex flex-col gap-1 px-4 py-3">
				<dt class="text-muted">{t(lang, 'settings.engine.modelsDir')}</dt>
				<dd id="engine-dir" class="rounded-md bg-code px-2 py-1 font-mono text-xs [overflow-wrap:anywhere]"></dd>
			</div>
			<div id="engine-crash-row" hidden class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 px-4 py-3">
				<dt class="text-muted">{t(lang, 'settings.engine.crashLogs.title')}</dt>
				<dd class="flex items-center gap-3">
					<span id="engine-crash-count" class="font-medium"></span>
					<button type="button" id="engine-crash-open" class={secondaryBtn}>{t(lang, 'settings.engine.crashLogs.open')}</button>
				</dd>
				<dd id="engine-crash-dir" class="basis-full rounded-md bg-code px-2 py-1 font-mono text-xs [overflow-wrap:anywhere]"></dd>
			</div>
		</dl>

		<h3 id="hw-title" class="mt-8 text-sm font-medium">{t(lang, 'settings.engine.hardware.title')}</h3>
		<p id="hw-description" class="mt-1 text-xs text-muted">{t(lang, 'settings.engine.hardware.description')}</p>
		<div class="mt-3 divide-y divide-border rounded-xl border border-border text-sm">
			<div class="flex items-center justify-between gap-4 px-4 py-3">
				<span class="text-muted">{t(lang, 'settings.engine.hardware.ram')}</span>
				<span id="hw-ram" class="font-medium"></span>
			</div>
			<div class="flex items-center justify-between gap-4 px-4 py-3">
				<span class="text-muted">{t(lang, 'settings.engine.hardware.gpu')}</span>
				<span id="hw-gpu" class="text-right font-medium"></span>
			</div>
			<div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 px-4 py-3">
				<div class="min-w-0">
					<p class="text-muted">{t(lang, 'settings.engine.hardware.used')}</p>
					<p id="hw-used" class="mt-0.5 font-medium"></p>
				</div>
				<button type="button" id="hw-manual-toggle" aria-expanded="false" aria-controls="hw-form" class={secondaryBtn}>{t(lang, 'settings.engine.hardware.manual')}</button>
			</div>
			<div id="hw-form" hidden class="space-y-4 px-4 py-4">
				<div>
					<label for="hw-ram-select" class={label}>{t(lang, 'settings.engine.hardware.ramLabel')}</label>
					<select id="hw-ram-select" class={`${input} [&>option]:bg-surface`}></select>
				</div>
				<div>
					<label for="hw-gpu-select" class={label}>{t(lang, 'settings.engine.hardware.gpuLabel')}</label>
					<select id="hw-gpu-select" class={`${input} [&>option]:bg-surface`}></select>
				</div>
				<div id="hw-vram-wrap" hidden>
					<label for="hw-vram-input" class={label}>{t(lang, 'settings.engine.hardware.vramLabel')}</label>
					<input id="hw-vram-input" type="number" min="1" max="512" step="1" inputmode="numeric" class={input} aria-describedby="hw-error" />
				</div>
				<p id="hw-error" role="alert" hidden class="text-xs text-danger"></p>
				<div class="flex flex-wrap items-center gap-2">
					<button type="button" id="hw-save" class={primaryBtn}>{t(lang, 'settings.engine.hardware.save')}</button>
					<button type="button" id="hw-reset" hidden class={secondaryBtn}>{t(lang, 'settings.engine.hardware.reset')}</button>
				</div>
			</div>
		</div>

		<h3 class="mt-8 text-sm font-medium">{t(lang, 'settings.engine.modelsTitle')}</h3>
		<ul id="engine-models" hidden class="mt-3 divide-y divide-border rounded-xl border border-border"></ul>
		<p id="engine-empty" hidden class="mt-3 rounded-xl border border-dashed border-border px-6 py-8 text-center text-sm text-muted">{t(lang, 'settings.engine.empty')}</p>
		<p class="mt-4 text-xs text-muted">{t(lang, 'settings.engine.help')}</p>
	</div>
	<p id="engine-loading" class="mt-6 text-sm text-muted">{t(lang, 'settings.connections.loading')}</p>
</section>

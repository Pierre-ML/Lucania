---
import { getLang, t } from '../../i18n/index';

interface Props {
	class?: string;
}
const { class: className = '' } = Astro.props;
const lang = getLang(Astro);
const secondaryBtn = 'inline-flex h-10 shrink-0 cursor-pointer items-center justify-center rounded-lg border border-border px-4 text-sm font-medium text-fg transition-[background-color,transform] duration-150 hover:bg-fg/5 focus-visible:outline-fg/40 active:scale-[0.97] disabled:cursor-not-allowed disabled:opacity-50 motion-reduce:transition-none';
const input = 'h-10 w-full rounded-lg border border-border bg-transparent px-3 text-sm text-fg transition-colors duration-150 hover:border-fg/20 focus:border-fg/40 focus-visible:outline-2 focus-visible:outline-fg/20 focus-visible:outline-offset-0';
---
<!-- Code de la tour : masqué par défaut, Afficher / Copier. Piloté par src/lib/client/server-key.js. -->
<div data-key-block hidden class={`space-y-2 ${className}`}>
	<label for="server-key-value" class="block text-sm font-medium">{t(lang, 'settings.server.key.label')}</label>
	<div class="flex gap-2">
		<input id="server-key-value" data-key-input type="password" readonly spellcheck="false" autocomplete="off" class={`${input} font-mono`} />
		<button type="button" data-key-toggle class={secondaryBtn}>{t(lang, 'settings.server.key.show')}</button>
		<button type="button" data-key-copy class={secondaryBtn}>{t(lang, 'settings.server.key.copy')}</button>
	</div>
	<p class="text-xs text-muted">{t(lang, 'settings.server.key.help')}</p>
</div>

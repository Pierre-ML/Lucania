---
import XIcon from '../assets/icons/x.svg';
import { getLang, t } from '../i18n/index';

const primaryBtn = 'inline-flex h-10 shrink-0 cursor-pointer items-center justify-center gap-1.5 rounded-lg bg-fg px-4 text-sm font-medium text-bg transition-[background-color,transform] duration-150 hover:bg-fg/90 focus-visible:outline-fg/40 active:scale-[0.97] disabled:cursor-not-allowed disabled:opacity-50 motion-reduce:transition-none';
const smallBtn = 'inline-flex h-8 shrink-0 cursor-pointer items-center justify-center rounded-lg border border-border px-3 text-xs font-medium text-fg transition-[background-color,transform] duration-150 hover:bg-fg/5 focus-visible:outline-fg/40 active:scale-[0.97] disabled:cursor-not-allowed disabled:opacity-50 motion-reduce:transition-none';
const smallPrimaryBtn = 'inline-flex h-8 shrink-0 cursor-pointer items-center justify-center rounded-lg bg-fg px-3 text-xs font-medium text-bg transition-[background-color,transform] duration-150 hover:bg-fg/90 focus-visible:outline-fg/40 active:scale-[0.97] disabled:cursor-not-allowed disabled:opacity-50 motion-reduce:transition-none';
const smallDangerBtn = 'inline-flex h-8 shrink-0 cursor-pointer items-center justify-center rounded-lg border border-danger/40 px-3 text-xs font-medium text-danger transition-[background-color,transform] duration-150 hover:bg-fg/5 focus-visible:outline-fg/40 active:scale-[0.97] disabled:cursor-not-allowed disabled:opacity-50 motion-reduce:transition-none';
const input = 'h-10 w-full rounded-lg border border-border bg-transparent px-3 text-sm text-fg transition-colors duration-150 placeholder:text-muted/60 hover:border-fg/20 focus:border-fg/40 focus-visible:outline-2 focus-visible:outline-fg/20 focus-visible:outline-offset-0';
const lang = getLang(Astro);
---
<dialog id="add-model-dialog" aria-labelledby="add-model-title" class="backdrop:bg-black/70 backdrop:backdrop-blur-sm m-auto max-h-[85vh] w-[min(48rem,calc(100vw-2rem))] max-w-none flex-col overflow-hidden rounded-2xl border border-border bg-surface p-0 text-fg shadow-[0_24px_80px_-12px_rgb(0_0_0/0.8)] open:flex open:animate-pop-in motion-reduce:animate-none">
	<div class="flex shrink-0 items-start justify-between gap-4 px-6 pb-4 pt-6">
		<div class="min-w-0">
			<h2 id="add-model-title" class="font-serif text-xl">{t(lang, 'chat.addModel.title')}</h2>
			<p class="mt-1 text-sm text-muted">{t(lang, 'chat.addModel.description')}</p>
		</div>
		<button type="button" data-action="add-model-close" aria-label={t(lang, 'chat.addModel.close')} title={t(lang, 'chat.addModel.close')} class="inline-flex size-8 shrink-0 cursor-pointer items-center justify-center rounded-md text-muted transition-colors duration-200 hover:bg-white/5 hover:text-fg focus-visible:outline-2">
			<XIcon width="18" height="18" aria-hidden="true" />
		</button>
	</div>

	<div data-hf="root" class="min-h-0 flex-1 overflow-y-auto px-6 pb-6">
		<p data-hf="unavailable" hidden class="rounded-xl border border-dashed border-border px-6 py-10 text-center text-sm text-muted"></p>
		<p data-hf="error" role="status" aria-live="polite" hidden class="mb-4 rounded-lg border border-danger/40 px-3 py-2 text-xs text-danger">
			<span data-hf="error-text"></span>
			<a data-hf="token-hint" hidden href="/parametres#huggingface" class="underline underline-offset-2 hover:opacity-80">{t(lang, 'chat.addModel.tokenLink')}</a>
		</p>

		<div data-hf="main" hidden class="space-y-6">
			<div data-hf="downloads-wrap" hidden>
				<h3 class="text-sm font-medium">{t(lang, 'chat.addModel.downloads.title')}</h3>
				<ul data-hf="downloads" class="mt-3 divide-y divide-border rounded-xl border border-border"></ul>
			</div>

			<div>
				<div data-hf="families" role="group" aria-label={t(lang, 'chat.addModel.families.label')} class="-mx-6 mb-3 flex gap-2 overflow-x-auto px-6 pb-1"></div>
				<form data-hf="search-form" role="search" class="flex gap-2">
					<label for="add-model-search" class="sr-only">{t(lang, 'chat.addModel.search.label')}</label>
					<input id="add-model-search" data-hf="search-input" type="search" autocomplete="off" spellcheck="false" placeholder={t(lang, 'chat.addModel.search.placeholder')} class={input} />
					<button type="submit" data-hf="search-btn" class={primaryBtn}>{t(lang, 'chat.addModel.search.button')}</button>
				</form>
				<div class="mt-3 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 text-xs text-muted">
					<p data-hf="profile">
						<span data-hf="profile-text"></span>
						<span aria-hidden="true">—</span>
						<a href="/parametres#moteur" class="underline underline-offset-2 hover:text-fg">{t(lang, 'chat.addModel.profile.edit')}</a>
					</p>
					<label class="flex cursor-pointer items-center gap-2">
						<input data-hf="hide-toobig" type="checkbox" class="size-4 accent-fg" />
						{t(lang, 'chat.addModel.hideTooBig')}
					</label>
				</div>
				<p data-hf="search-status"role="status" aria-live="polite" class="mt-3 text-sm text-muted"></p>
				<ul data-hf="results" hidden class="mt-3 divide-y divide-border rounded-xl border border-border"></ul>
				<p data-hf="results-empty" hidden class="mt-3 rounded-xl border border-dashed border-border px-6 py-8 text-center text-sm text-muted">{t(lang, 'chat.addModel.search.empty')}</p>
			</div>
		</div>

		<template data-hf="tpl-download">
			<li data-dl class="space-y-2 px-4 py-3">
				<div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2">
					<div class="min-w-0 flex-1">
						<p data-dl-name class="truncate font-mono text-sm"></p>
						<p data-dl-repo class="truncate text-xs text-muted"></p>
					</div>
					<div class="flex shrink-0 items-center gap-2">
						<button type="button" data-dl-use hidden class={smallPrimaryBtn}>{t(lang, 'chat.addModel.downloads.use')}</button>
						<button type="button" data-dl-pause hidden class={smallBtn}>{t(lang, 'chat.addModel.downloads.pause')}</button>
						<button type="button" data-dl-resume hidden class={smallBtn}>{t(lang, 'chat.addModel.downloads.resume')}</button>
						<button type="button" data-dl-cancel hidden class={smallDangerBtn}>{t(lang, 'chat.addModel.downloads.cancel')}</button>
					</div>
				</div>
				<progress data-dl-bar class="progress h-1.5 w-full text-fg" value="0" max="100"></progress>
				<div class="flex flex-wrap justify-between gap-x-4 gap-y-1 text-xs text-muted">
					<span data-dl-bytes></span>
					<span data-dl-state></span>
				</div>
				<p data-dl-error hidden class="text-xs text-danger"></p>
			</li>
		</template>
	</div>
</dialog>

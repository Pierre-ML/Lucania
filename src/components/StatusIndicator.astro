---
import { getLang, t } from '../i18n/index';
const lang = getLang(Astro);
---
<div id="status-indicator" class="flex items-center gap-2">
	<span id="status-dot" data-status="checking" class="size-2 rounded-full bg-muted data-[status=checking]:animate-dot-pulse motion-reduce:animate-none data-[status=online]:bg-emerald-500 data-[status=online]:shadow-[0_0_8px_rgb(16_185_129/0.55)] data-[status=offline]:bg-danger"></span>
	<span id="status-label" class="hidden text-xs text-muted sm:inline">{t(lang, 'chat.status.checking')}</span>
</div>

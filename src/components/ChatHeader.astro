---
import StatusIndicator from './StatusIndicator.astro';
import { getLang, t } from '../i18n/index';
const lang = getLang(Astro);
---
<header class="sticky top-0 z-10 flex h-14 shrink-0 items-center gap-2 border-b border-border/60 bg-bg/80 px-3 backdrop-blur-md">
	<button id="sidebar-toggle" type="button" class="inline-flex size-9 shrink-0 items-center justify-center rounded-lg text-muted transition-colors hover:bg-white/[0.07] hover:text-fg" aria-label={t(lang, 'chat.header.toggleSidebar')} aria-controls="sidebar" aria-expanded="true">
		<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="3.5"/><path d="M9 4v16"/></svg>
	</button>
	<h1 id="chat-title" class="min-w-0 flex-1 truncate px-1 text-sm font-medium tracking-tight">{t(lang, 'chat.header.defaultTitle')}</h1>
	<StatusIndicator />
</header>

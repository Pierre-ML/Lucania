---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import ChatHeader from '../components/ChatHeader.astro';
import MessageList from '../components/MessageList.astro';
import Composer from '../components/Composer.astro';
import ConfirmDialog from '../components/ConfirmDialog.astro';
import MemoryProposal from '../components/MemoryProposal.astro';
import ShutdownButton from '../components/ShutdownButton.astro';
import AddModelDialog from '../components/AddModelDialog.astro';
import ModelSettingsDialog from '../components/ModelSettingsDialog.astro';
---
<Layout>
	<div class="flex h-dvh overflow-hidden">
		<Sidebar />
		<div class="flex min-w-0 flex-1 flex-col">
			<ChatHeader />
			<MessageList />
			<Composer />
		</div>
	</div>
	<AddModelDialog />
	<ModelSettingsDialog />
	<ShutdownButton />
	<ConfirmDialog />
	<MemoryProposal />
</Layout>

<script>
  import '../lib/client/app.js';
</script>

<script>
  import { guardServerMode } from '../lib/client/server-guard.js';
  guardServerMode();
</script>

---
import LogoCard from './LogoCard.astro';
---
<section id="set-b" class="space-y-6">
  <header>
    <h2 class="font-serif text-2xl">Neural &amp; organique</h2>
    <p class="text-sm text-muted">Cerveaux, cellules, feuilles et ondes : une IA vivante, née du vivant plutôt que du circuit.</p>
  </header>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
    <LogoCard id="B1" name="Cortex" vibe="Deux hémisphères pleins, sobres et sûrs de leur intelligence." tags={["cerveau", "symétrie", "solide"]}>
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M29 10C20 7 10 14 12 25C5 29 7 40 14 43C14 51 23 57 29 52Z" fill="currentColor" />
        <path d="M35 10C44 7 54 14 52 25C59 29 57 40 50 43C50 51 41 57 35 52Z" fill="currentColor" />
      </svg>
    </LogoCard>

    <LogoCard id="B2" name="Encre" vibe="Une goutte tombée sur la page, prête à écrire la suite." tags={["goutte", "encre", "rouge"]}>
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M32 5C26 16 14 28 14 40a18 18 0 0 0 36 0C50 28 38 16 32 5Z" fill="#e5383b" />
        <path d="M23 41a9 9 0 0 0 7 9" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
      </svg>
    </LogoCard>

    <LogoCard id="B3" name="Pouls" vibe="Un électrocardiogramme nerveux : l'IA qui a du cœur." tags={["pulsation", "ligne", "énergie"]}>
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M5 34H18L25 14L34 51L42 25L46 34H59" stroke="currentColor" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </LogoCard>

    <LogoCard id="B4" name="Medusa" vibe="Flottante et lumineuse, elle pense en silence dans les profondeurs." tags={["méduse", "dégradé", "fluide"]}>
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <defs>
          <linearGradient id="b4-grad" x1="32" y1="6" x2="32" y2="36" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#e5383b" />
            <stop offset="1" stop-color="#8f1d24" />
          </linearGradient>
        </defs>
        <path d="M10 34C10 18 20 6 32 6C44 6 54 18 54 34Z" fill="url(#b4-grad)" />
        <path d="M19 41C14 46 24 49 19 58M32 41C27 46 37 49 32 58M45 41C40 46 50 49 45 58" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" />
      </svg>
    </LogoCard>

    <LogoCard id="B5" name="Germe" vibe="Une idée qui sort de terre : jeune, calme, en croissance." tags={["graine", "pousse", "croissance"]}>
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M32 56V30" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
        <path d="M32 36C18 38 11 29 11 18C24 18 32 24 32 36Z" fill="currentColor" />
        <path d="M32 29C32 17 40 9 53 9C53 21 45 29 32 29Z" fill="currentColor" />
        <path d="M16 56H48" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
      </svg>
    </LogoCard>

    <LogoCard id="B6" name="Phi" vibe="Une spirale d'or : l'élégance mathématique de la nature." tags={["fibonacci", "spirale", "harmonie"]}>
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M26 32a6 6 0 0 1 12 0a12 12 0 0 1-24 0a18 18 0 0 1 36 0" transform="translate(0 3)" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
      </svg>
    </LogoCard>

    <LogoCard id="B7" name="Mitose" vibe="Une cellule qui se divise : deux esprits à partir d'un seul." tags={["cellule", "division", "rouge"]}>
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="21" cy="32" r="14" fill="currentColor" />
        <circle cx="43" cy="32" r="14" fill="currentColor" />
        <circle cx="19" cy="32" r="5.5" fill="#e5383b" />
        <circle cx="45" cy="32" r="5.5" fill="#e5383b" />
      </svg>
    </LogoCard>

    <LogoCard id="B8" name="Astérisme" vibe="Des points reliés dans la nuit : le savoir comme constellation." tags={["constellation", "réseau", "nuit"]}>
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M12 46L26 24L40 40L54 16M40 40L50 53" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
        <circle cx="12" cy="46" r="6" fill="currentColor" />
        <circle cx="26" cy="24" r="6" fill="currentColor" />
        <circle cx="40" cy="40" r="6" fill="currentColor" />
        <circle cx="54" cy="14" r="6" fill="currentColor" />
        <circle cx="50" cy="52" r="5" fill="currentColor" />
      </svg>
    </LogoCard>

    <LogoCard id="B9" name="Fronde" vibe="Une feuille nervurée, discrète et durable, à l'esprit zen." tags={["feuille", "nature", "contour"]}>
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M10 54C8 26 26 10 54 10C56 38 40 56 10 54Z" stroke="currentColor" stroke-width="4" stroke-linejoin="round" />
        <path d="M10 54L38 26" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
      </svg>
    </LogoCard>

    <LogoCard id="B10" name="Écho" vibe="Une source et ses ondes : la voix qui se propage." tags={["ondes", "voix", "rouge"]}>
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <g transform="translate(6 0)">
          <circle cx="12" cy="32" r="6" fill="#e5383b" />
          <path d="M22.5 23.5A12 12 0 0 1 22.5 40.5" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
          <path d="M29.6 16.4A22 22 0 0 1 29.6 47.6" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
          <path d="M36.5 10A32 32 0 0 1 36.5 54" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
        </g>
      </svg>
    </LogoCard>
  </div>
</section>

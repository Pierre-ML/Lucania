---
import LogoCard from './LogoCard.astro';
---
<section id="set-c" class="space-y-6">
  <header>
    <h2 class="font-serif text-2xl">Tech & monogrammes</h2>
    <p class="text-sm text-muted">Cubes isométriques, invites de terminal, puces et lettres géométriques : l'esprit outil de dev, local et sans fioritures.</p>
  </header>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
    <LogoCard id="C1" name="Isocube" vibe="Un bloc de calcul posé sur ta machine, solide et en trois dimensions." tags={["cube", "isométrique", "volume"]}>
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M32 6 54 19 32 32 10 19Z" fill="currentColor" />
        <path d="M10 19 32 32V58L10 45Z" fill="currentColor" fill-opacity="0.6" />
        <path d="M54 19 32 32V58L54 45Z" fill="currentColor" fill-opacity="0.3" />
      </svg>
    </LogoCard>

    <LogoCard id="C2" name="Prompt" vibe="L'invite de commande, sage et directe, avec un souffle rouge." tags={["terminal", "app icon", "rouge"]}>
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect x="4" y="4" width="56" height="56" rx="14" fill="currentColor" />
        <path d="M18 22 31 32 18 42" stroke="#e5383b" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M36 44H48" stroke="#e5383b" stroke-width="6" stroke-linecap="round" />
      </svg>
    </LogoCard>

    <LogoCard id="C3" name="Braces" vibe="Deux accolades qui encadrent un point : le code, et rien d'autre." tags={["accolades", "code", "minimal"]}>
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M24 8C18 8 18 12 18 16V25C18 29 14 32 10 32 14 32 18 35 18 39V48C18 52 18 56 24 56" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M40 8C46 8 46 12 46 16V25C46 29 50 32 54 32 50 32 46 35 46 39V48C46 52 46 56 40 56" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
        <circle cx="32" cy="32" r="4" fill="currentColor" />
      </svg>
    </LogoCard>

    <LogoCard id="C4" name="Die" vibe="Une puce entourée de ses broches : le modèle tourne ici, sur le silicium." tags={["puce", "CPU", "hardware"]}>
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M24 5V16M32 5V16M40 5V16M24 48V59M32 48V59M40 48V59M5 24H16M5 32H16M5 40H16M48 24H59M48 32H59M48 40H59" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
        <rect x="16" y="16" width="32" height="32" rx="5" stroke="currentColor" stroke-width="4" />
        <rect x="25" y="25" width="14" height="14" rx="2" fill="currentColor" />
      </svg>
    </LogoCard>

    <LogoCard id="C5" name="Bit L" vibe="Un L en pixels 8-bit, nostalgique et ludique, avec des pixels qui s'éteignent." tags={["pixel", "8-bit", "monogramme L"]}>
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M12 12H20V44H52V52H12Z" fill="currentColor" />
        <rect x="36" y="12" width="8" height="8" fill="currentColor" fill-opacity="0.6" />
        <rect x="44" y="20" width="8" height="8" fill="currentColor" fill-opacity="0.3" />
        <rect x="36" y="28" width="8" height="8" fill="currentColor" fill-opacity="0.6" />
        <rect x="28" y="20" width="8" height="8" fill="currentColor" fill-opacity="0.3" />
      </svg>
    </LogoCard>

    <LogoCard id="C6" name="IA Mono" vibe="Un I et un A tracés à la règle, barre rouge comme étincelle d'intelligence." tags={["monogramme", "IA", "géométrique"]}>
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect x="6" y="10" width="8" height="44" fill="currentColor" />
        <path d="M23 54 40 10 57 54" stroke="currentColor" stroke-width="8" stroke-linejoin="miter" />
        <path d="M31 42H49" stroke="#e5383b" stroke-width="6" />
      </svg>
    </LogoCard>

    <LogoCard id="C7" name="Rack" vibe="Trois unités de serveur empilées : ton propre datacenter de poche." tags={["serveur", "rack", "local"]}>
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect x="8" y="8" width="48" height="12" rx="3" stroke="currentColor" stroke-width="3" />
        <rect x="8" y="26" width="48" height="12" rx="3" stroke="currentColor" stroke-width="3" />
        <rect x="8" y="44" width="48" height="12" rx="3" stroke="currentColor" stroke-width="3" />
        <circle cx="17" cy="14" r="2.5" fill="currentColor" />
        <circle cx="17" cy="32" r="2.5" fill="currentColor" />
        <circle cx="17" cy="50" r="2.5" fill="currentColor" />
        <path d="M28 14H47M28 32H47M28 50H47" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-opacity="0.5" />
      </svg>
    </LogoCard>

    <LogoCard id="C8" name="Caret" vibe="Un curseur I-beam suivi d'un bloc rouge qui clignote : l'attente de la prochaine idée." tags={["curseur", "saisie", "rouge"]}>
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M10 8H34V15H26V49H34V56H10V49H18V15H10Z" fill="currentColor" />
        <rect x="42" y="14" width="14" height="36" fill="#e5383b" />
      </svg>
    </LogoCard>

    <LogoCard id="C9" name="Airlock" vibe="Un bouclier à serrure : rien ne sort, tout reste privé et hors ligne." tags={["bouclier", "privé", "offline"]}>
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M32 5 54 13V32C54 44 45 52 32 59 19 52 10 44 10 32V13Z" fill="currentColor" fill-opacity="0.25" stroke="currentColor" stroke-width="4" stroke-linejoin="round" />
        <circle cx="32" cy="27" r="6" fill="currentColor" />
        <path d="M28 31H36L38 44H26Z" fill="currentColor" />
      </svg>
    </LogoCard>

    <LogoCard id="C10" name="Facette" vibe="Un diamant taillé en facettes : précieux, net, concentré." tags={["diamant", "facettes", "premium"]}>
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M18 10H46L40 24H24Z" fill="currentColor" />
        <path d="M18 10 24 24H6Z" fill="currentColor" fill-opacity="0.6" />
        <path d="M46 10 58 24H40Z" fill="currentColor" fill-opacity="0.6" />
        <path d="M6 24H24L32 58Z" fill="currentColor" fill-opacity="0.45" />
        <path d="M24 24H40L32 58Z" fill="currentColor" fill-opacity="0.8" />
        <path d="M40 24H58L32 58Z" fill="currentColor" fill-opacity="0.3" />
      </svg>
    </LogoCard>
  </div>
</section>

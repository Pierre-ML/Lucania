---
interface Props {
  id: string;
  name: string;
  vibe: string;
  tags?: string[];
}
const { id, name, vibe, tags = [] } = Astro.props;
const svg = await Astro.slots.render('default');
---

<article class="bg-surface/60 border border-border rounded-2xl p-4 hover:border-accent/40 transition flex flex-col gap-3">
  <div class="bg-bg text-fg border border-border rounded-xl h-44 flex items-center justify-center">
    <span class="block size-28 [&>svg]:size-full"><Fragment set:html={svg} /></span>
  </div>
  <div class="grid grid-cols-[auto_1fr] gap-3">
    <div class="bg-white text-neutral-900 border border-border rounded-xl size-20 flex items-center justify-center">
      <span class="block size-14 [&>svg]:size-full"><Fragment set:html={svg} /></span>
    </div>
    <div class="bg-bg text-fg border border-border rounded-xl flex items-center justify-center gap-5 px-3">
      <span class="block size-4 [&>svg]:size-full"><Fragment set:html={svg} /></span>
      <span class="block size-6 [&>svg]:size-full"><Fragment set:html={svg} /></span>
      <span class="block size-10 [&>svg]:size-full"><Fragment set:html={svg} /></span>
    </div>
  </div>
  <div>
    <div class="flex items-center gap-2">
      <span class="font-mono text-xs text-accent border border-border rounded px-1.5 py-0.5">{id}</span>
      <h3 class="font-medium">{name}</h3>
    </div>
    <p class="text-sm text-muted mt-1">{vibe}</p>
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 mt-2">
        {tags.map((t) => <span class="text-[11px] border border-border rounded-full px-2 text-muted">{t}</span>)}
      </div>
    )}
  </div>
</article>

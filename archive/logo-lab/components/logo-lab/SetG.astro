---
import LogoCard from './LogoCard.astro';
---
<section id="set-g" class="space-y-6">
  <header>
    <h2 class="font-serif text-2xl">Volumes isométriques</h2>
    <p class="text-sm text-muted">Des blocs, des piles et des lettres extrudées dans la même projection que l'Isocube : trois faces, une lumière, une silhouette franche.</p>
  </header>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
    <LogoCard id="G1" name="Escalier" vibe="Trois cubes en escalier : on monte en puissance, marche après marche." tags={["escalier","cubes","progression"]}>
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M22.3 4L32 9.6L22.3 15.2L12.6 9.6ZM32 20.8L41.7 26.4L32 32L22.3 26.4ZM41.7 37.6L51.4 43.2L41.7 48.8L32 43.2Z" fill="currentColor" />
        <path d="M12.6 9.6L22.3 15.2L22.3 26.4L32 32L32 43.2L41.7 48.8L41.7 60L12.6 43.2Z" fill="currentColor" fill-opacity="0.6" />
        <path d="M32 9.6L32 20.8L22.3 26.4L22.3 15.2ZM41.7 26.4L41.7 37.6L32 43.2L32 32ZM51.4 43.2L51.4 54.4L41.7 60L41.7 48.8Z" fill="currentColor" fill-opacity="0.3" />
      </svg>
    </LogoCard>

    <LogoCard id="G2" name="Cadre" vibe="Un cube évidé réduit à son ossature : transparent, ouvert, rien à cacher." tags={["cadre","filaire","transparent"]}>
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M32 4L56.25 18L32 32L7.75 18ZM32 13.33L23.92 18L32 22.67L40.08 18ZM15.83 41.33L23.92 36.67L23.92 46ZM40.08 36.67L48.17 41.33L40.08 46Z" fill="currentColor" />
        <path d="M7.75 18L32 32L32 60L7.75 46ZM32 13.33L40.08 18L32 22.67ZM23.92 36.67L15.83 32L15.83 41.33L23.92 46ZM40.08 36.67L48.17 32L48.17 41.33Z" fill="currentColor" fill-opacity="0.6" />
        <path d="M23.92 18L32 13.33L32 22.67ZM15.83 32L23.92 36.67L15.83 41.33ZM56.25 18L56.25 46L32 60L32 32ZM48.17 32L40.08 36.67L40.08 46L48.17 41.33Z" fill="currentColor" fill-opacity="0.3" />
      </svg>
    </LogoCard>

    <LogoCard id="G3" name="Monolithe" vibe="La tour posée sous ton bureau, striée de fentes d'aération : la machine locale." tags={["tour","PC","local"]}>
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M32 4L44.12 11L32 18L19.88 11ZM23.92 22.67L27.96 25L27.96 29.67L19.88 25ZM23.92 32L27.96 34.33L27.96 39L19.88 34.33ZM23.92 41.33L27.96 43.67L27.96 48.33L19.88 43.67Z" fill="currentColor" />
        <path d="M19.88 11L32 18L32 60L19.88 53L19.88 43.67L27.96 48.33L27.96 43.67L19.88 39L19.88 34.33L27.96 39L27.96 34.33L19.88 29.67L19.88 25L27.96 29.67L27.96 25L19.88 20.33Z" fill="currentColor" fill-opacity="0.6" />
        <path d="M44.12 11L44.12 53L32 60L32 18Z" fill="currentColor" fill-opacity="0.3" />
      </svg>
    </LogoCard>

    <LogoCard id="G4" name="Prisme" vibe="Un prisme hexagonal taillé net, trois faces et une seule lumière." tags={["hexagone","prisme","cristal"]}>
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M58.05 17.02L45.02 30.05L18.98 30.05L5.95 17.02L18.98 4L45.02 4Z" fill="currentColor" />
        <path d="M5.95 17.02L18.98 30.05L18.98 60L5.95 46.98Z" fill="currentColor" fill-opacity="0.6" />
        <path d="M18.98 30.05L45.02 30.05L45.02 60L18.98 60Z" fill="currentColor" fill-opacity="0.45" />
        <path d="M45.02 30.05L58.05 17.02L58.05 46.98L45.02 60Z" fill="currentColor" fill-opacity="0.3" />
      </svg>
    </LogoCard>

    <LogoCard id="G5" name="Saillie" vibe="Un cube sage dont un bloc rouge dépasse : l'idée qui sort du cadre." tags={["cube","rouge","accent"]}>
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M28 4.29L52 18.14L28 32L4 18.14Z" fill="currentColor" />
        <path d="M52 18.14L60 22.76L52 27.38L44 22.76Z" fill="#e5383b" />
        <path d="M4 18.14L28 32L28 59.71L4 45.86Z" fill="currentColor" fill-opacity="0.6" />
        <path d="M44 22.76L52 27.38L52 36.62L44 32Z" fill="#e5383b" fill-opacity="0.7" />
        <path d="M44 22.76L44 32L52 36.62L52 45.86L28 59.71L28 32Z" fill="currentColor" fill-opacity="0.3" />
        <path d="M52 27.38L60 22.76L60 32L52 36.62Z" fill="#e5383b" fill-opacity="0.45" />
      </svg>
    </LogoCard>

    <LogoCard id="G6" name="Local" vibe="Un L extrudé, massif, posé sur la table : ça tourne ici, chez toi." tags={["lettre L","extrusion","local"]}>
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M25.07 4L34.31 9.33L25.07 14.67L15.83 9.33ZM34.31 36L48.17 44L38.93 49.33L25.07 41.33Z" fill="currentColor" />
        <path d="M15.83 9.33L25.07 14.67L25.07 41.33L38.93 49.33L38.93 60L15.83 46.67Z" fill="currentColor" fill-opacity="0.6" />
        <path d="M34.31 9.33L34.31 36L25.07 41.33L25.07 14.67ZM48.17 44L48.17 54.67L38.93 60L38.93 49.33Z" fill="currentColor" fill-opacity="0.3" />
      </svg>
    </LogoCard>

    <LogoCard id="G7" name="IA Bloc" vibe="Les lettres I et A sculptées en blocs isométriques." tags={["monogramme","IA","extrusion"]}>
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M18.42 4L26.18 8.48L18.42 12.96L10.66 8.48ZM30.06 10.72L53.34 24.16L45.58 28.64L22.3 15.2ZM37.82 28.64L37.82 37.6L30.06 33.12Z" fill="currentColor" />
        <path d="M10.66 8.48L18.42 12.96L18.42 44.32L10.66 39.84ZM22.3 15.2L45.58 28.64L45.58 60L37.82 55.52L37.82 42.08L30.06 37.6L30.06 51.04L22.3 46.56ZM30.06 24.16L30.06 33.12L37.82 37.6L37.82 28.64Z" fill="currentColor" fill-opacity="0.6" />
        <path d="M26.18 8.48L26.18 12.96L22.3 15.2L22.3 42.08L18.42 44.32L18.42 12.96ZM30.06 24.16L37.82 28.64L30.06 33.12ZM53.34 24.16L53.34 55.52L45.58 60L45.58 28.64ZM30.06 37.6L37.82 42.08L37.82 46.56L30.06 51.04Z" fill="currentColor" fill-opacity="0.3" />
      </svg>
    </LogoCard>

    <LogoCard id="G8" name="Tetris" vibe="Un cube de 2x2x2 auquel il manque un bloc : la pièce qui s'emboîte." tags={["blocs","data","puzzle"]}>
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M32 4L56.25 18L44.12 25L32 18L19.88 25L7.75 18ZM32 32L44.12 39L32 46L19.88 39Z" fill="currentColor" />
        <path d="M7.75 18L19.88 25L19.88 39L32 46L32 60L7.75 46ZM32 18L44.12 25L44.12 39L32 32Z" fill="currentColor" fill-opacity="0.6" />
        <path d="M19.88 25L32 18L32 32L19.88 39ZM44.12 25L56.25 18L56.25 46L32 60L32 46L44.12 39Z" fill="currentColor" fill-opacity="0.3" />
      </svg>
    </LogoCard>

    <LogoCard id="G9" name="Ziggourat" vibe="Une pyramide à degrés couronnée de rouge : le sommet de la pile." tags={["pyramide","degrés","rouge"]}>
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M32 6.13L37.6 9.37L32 12.6L26.4 9.37Z" fill="#e5383b" />
        <path d="M26.4 9.37L26.4 15.83L32 19.07L37.6 15.83L37.6 9.37L48.8 15.83L32 25.53L15.2 15.83ZM15.2 22.3L15.2 28.77L32 38.47L48.8 28.77L48.8 22.3L60 28.77L32 44.93L4 28.77Z" fill="currentColor" />
        <path d="M26.4 9.37L32 12.6L32 19.07L26.4 15.83Z" fill="#e5383b" fill-opacity="0.7" />
        <path d="M15.2 15.83L32 25.53L32 38.47L15.2 28.77ZM4 28.77L32 44.93L32 57.87L4 41.7Z" fill="currentColor" fill-opacity="0.6" />
        <path d="M32 12.6L37.6 9.37L37.6 15.83L32 19.07Z" fill="#e5383b" fill-opacity="0.45" />
        <path d="M48.8 15.83L48.8 28.77L32 38.47L32 25.53ZM60 28.77L60 41.7L32 57.87L32 44.93Z" fill="currentColor" fill-opacity="0.3" />
      </svg>
    </LogoCard>

    <LogoCard id="G10" name="Jaillissement" vibe="Un cube ouvert d'où s'échappent des étincelles : l'idée qui jaillit." tags={["cube ouvert","étincelle","rouge"]}>
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M26 24L43.32 34L26 44L8.68 34ZM26 28L15.61 34L26 40L36.39 34Z" fill="currentColor" />
        <path d="M8.68 34L26 44L26 60L8.68 50ZM26 28L36.39 34L26 40Z" fill="currentColor" fill-opacity="0.6" />
        <path d="M26 28L26 40L15.61 34ZM43.32 34L43.32 50L26 60L26 44Z" fill="currentColor" fill-opacity="0.3" />
        <path d="M47 4L49.6 11.4L57 14L49.6 16.6L47 24L44.4 16.6L37 14L44.4 11.4Z" fill="#e5383b" />
        <path d="M56 26L57.3 29.7L61 31L57.3 32.3L56 36L54.7 32.3L51 31L54.7 29.7Z" fill="#e5383b" fill-opacity="0.6" />
      </svg>
    </LogoCard>
  </div>
</section>

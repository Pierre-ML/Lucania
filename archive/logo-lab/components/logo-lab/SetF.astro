---
import LogoCard from './LogoCard.astro';
---
<section id="set-f" class="space-y-6">
  <header>
    <h2 class="font-serif text-2xl">Cristaux & gemmes</h2>
    <p class="text-sm text-muted">La famille Facette : polygones plats, arêtes franches et opacités variées pour simuler la lumière sur des gemmes, cristaux et solides taillés.</p>
  </header>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
    <LogoCard id="F1" name="Brillant" vibe="Une gemme taille brillant vue de face : huit facettes autour d'une table." tags={["brillant", "face", "gemme"]}>
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M26 20H38L44 26V38L38 44H26L20 38V26Z" fill="currentColor" />
        <path d="M22 4H42L38 20H26Z" fill="currentColor" fill-opacity="0.7" />
        <path d="M42 4 60 22 44 26 38 20Z" fill="currentColor" fill-opacity="0.45" />
        <path d="M60 22V42L44 38V26Z" fill="currentColor" fill-opacity="0.6" />
        <path d="M60 42 42 60 38 44 44 38Z" fill="currentColor" fill-opacity="0.25" />
        <path d="M42 60H22L26 44H38Z" fill="currentColor" fill-opacity="0.45" />
        <path d="M22 60 4 42 20 38 26 44Z" fill="currentColor" fill-opacity="0.6" />
        <path d="M4 42V22L20 26V38Z" fill="currentColor" fill-opacity="0.8" />
        <path d="M4 22 22 4 26 20 20 26Z" fill="currentColor" fill-opacity="0.3" />
      </svg>
    </LogoCard>

    <LogoCard id="F2" name="Émeraude" vibe="La taille rectangulaire en gradins, avec une table rubis au centre." tags={["émeraude", "rectangle", "rubis"]}>
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M22 16H42L46 20V44L42 48H22L18 44V20Z" fill="#e5383b" />
        <path d="M18 4H46L42 16H22Z" fill="currentColor" fill-opacity="0.8" />
        <path d="M46 4 54 12 46 20 42 16Z" fill="currentColor" fill-opacity="0.45" />
        <path d="M54 12V52L46 44V20Z" fill="currentColor" fill-opacity="0.6" />
        <path d="M54 52 46 60 42 48 46 44Z" fill="currentColor" fill-opacity="0.25" />
        <path d="M46 60H18L22 48H42Z" fill="currentColor" fill-opacity="0.45" />
        <path d="M18 60 10 52 18 44 22 48Z" fill="currentColor" fill-opacity="0.6" />
        <path d="M10 52V12L18 20V44Z" fill="currentColor" />
        <path d="M10 12 18 4 22 16 18 20Z" fill="currentColor" fill-opacity="0.3" />
      </svg>
    </LogoCard>

    <LogoCard id="F3" name="Grappe" vibe="Trois cristaux de quartz qui poussent ensemble, pointes vers le haut." tags={["quartz", "grappe", "cristal"]}>
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M32 4 40 18H32Z" fill="currentColor" />
        <path d="M32 4 24 18H32Z" fill="currentColor" fill-opacity="0.7" />
        <path d="M24 18H32V58H24Z" fill="currentColor" fill-opacity="0.45" />
        <path d="M32 18H40V58H32Z" fill="currentColor" fill-opacity="0.25" />
        <path d="M14 22 22 34H14Z" fill="currentColor" />
        <path d="M14 22 6 34H14Z" fill="currentColor" fill-opacity="0.7" />
        <path d="M6 34H14V58H6Z" fill="currentColor" fill-opacity="0.45" />
        <path d="M14 34H22V58H14Z" fill="currentColor" fill-opacity="0.25" />
        <path d="M50 16 58 28H50Z" fill="currentColor" />
        <path d="M50 16 42 28H50Z" fill="currentColor" fill-opacity="0.7" />
        <path d="M42 28H50V58H42Z" fill="currentColor" fill-opacity="0.45" />
        <path d="M50 28H58V58H50Z" fill="currentColor" fill-opacity="0.25" />
      </svg>
    </LogoCard>

    <LogoCard id="F4" name="Obsidienne" vibe="Un éclat de verre volcanique, tranchant et sombre." tags={["éclat", "obsidienne", "shard"]}>
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M30 4 46 24 28 30Z" fill="currentColor" />
        <path d="M46 24 36 60 28 30Z" fill="currentColor" fill-opacity="0.45" />
        <path d="M36 60 18 50 28 30Z" fill="currentColor" fill-opacity="0.25" />
        <path d="M18 50 12 26 28 30Z" fill="currentColor" fill-opacity="0.6" />
        <path d="M12 26 30 4 28 30Z" fill="currentColor" fill-opacity="0.8" />
      </svg>
    </LogoCard>

    <LogoCard id="F5" name="Prisme" vibe="Un prisme triangulaire couché : la lumière entre, les idées en sortent." tags={["prisme", "triangle", "volume"]}>
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M6 54 18 22 30 54Z" fill="currentColor" />
        <path d="M18 22 46 14 58 46Z" fill="currentColor" fill-opacity="0.6" />
        <path d="M18 22 58 46 30 54Z" fill="currentColor" fill-opacity="0.3" />
      </svg>
    </LogoCard>

    <LogoCard id="F6" name="Octaèdre" vibe="Deux pyramides jointes par la base : symétrie parfaite, six sommets." tags={["octaèdre", "pyramide", "symétrie"]}>
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M32 4 6 32 32 44Z" fill="currentColor" fill-opacity="0.7" />
        <path d="M32 4 58 32 32 44Z" fill="currentColor" />
        <path d="M6 32 32 44 32 60Z" fill="currentColor" fill-opacity="0.3" />
        <path d="M58 32 32 44 32 60Z" fill="currentColor" fill-opacity="0.45" />
      </svg>
    </LogoCard>

    <LogoCard id="F7" name="Icosaèdre" vibe="Un solide de vingt faces vu de dessus, ramené à dix triangles." tags={["icosaèdre", "triangles", "polyèdre"]}>
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M20 26H44L32 46Z" fill="currentColor" />
        <path d="M32 4 44 26H20Z" fill="currentColor" fill-opacity="0.6" />
        <path d="M32 4 56 18 44 26Z" fill="currentColor" fill-opacity="0.3" />
        <path d="M32 4 8 18 20 26Z" fill="currentColor" fill-opacity="0.8" />
        <path d="M56 18V46L44 26Z" fill="currentColor" fill-opacity="0.45" />
        <path d="M44 26 56 46H32Z" fill="currentColor" fill-opacity="0.7" />
        <path d="M56 46 32 60V46Z" fill="currentColor" fill-opacity="0.25" />
        <path d="M32 60 8 46H32Z" fill="currentColor" fill-opacity="0.45" />
        <path d="M8 46 20 26 32 46Z" fill="currentColor" fill-opacity="0.3" />
        <path d="M8 46V18L20 26Z" fill="currentColor" fill-opacity="0.6" />
      </svg>
    </LogoCard>

    <LogoCard id="F8" name="Cœur de cristal" vibe="Un cœur taillé en facettes, avec un éclat rubis dans le lobe droit." tags={["cœur", "rubis", "affection"]}>
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M32 34 32 18 24 7Z" fill="currentColor" fill-opacity="0.7" />
        <path d="M32 34 24 7 12 7Z" fill="currentColor" />
        <path d="M32 34 12 7 4 18Z" fill="currentColor" fill-opacity="0.6" />
        <path d="M32 34 4 18V28Z" fill="currentColor" fill-opacity="0.45" />
        <path d="M32 34 4 28 32 60Z" fill="currentColor" fill-opacity="0.8" />
        <path d="M32 34 40 7 32 18Z" fill="currentColor" fill-opacity="0.45" />
        <path d="M32 34 52 7 40 7Z" fill="#e5383b" />
        <path d="M32 34 60 18 52 7Z" fill="currentColor" fill-opacity="0.3" />
        <path d="M32 34 60 28 60 18Z" fill="currentColor" fill-opacity="0.25" />
        <path d="M32 34 32 60 60 28Z" fill="currentColor" fill-opacity="0.3" />
      </svg>
    </LogoCard>

    <LogoCard id="F9" name="Goutte rubis" vibe="Une goutte taillée comme un rubis : une seule pointe, huit facettes rouges." tags={["goutte", "rubis", "accent"]}>
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M32 4 47 27 32 38Z" fill="#e5383b" />
        <path d="M32 4 32 38 17 27Z" fill="#e5383b" fill-opacity="0.7" />
        <path d="M47 27 55 41 32 38Z" fill="#e5383b" fill-opacity="0.6" />
        <path d="M55 41 46 57 32 38Z" fill="#e5383b" fill-opacity="0.3" />
        <path d="M46 57 32 60 32 38Z" fill="#e5383b" fill-opacity="0.45" />
        <path d="M32 60 18 57 32 38Z" fill="#e5383b" fill-opacity="0.6" />
        <path d="M18 57 9 41 32 38Z" fill="#e5383b" fill-opacity="0.8" />
        <path d="M9 41 17 27 32 38Z" fill="#e5383b" fill-opacity="0.9" />
      </svg>
    </LogoCard>

    <LogoCard id="F10" name="Étoile" vibe="Une étoile à quatre branches, huit triangles pour une scintillation." tags={["étoile", "scintillement", "quatre branches"]}>
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M32 4 39 25 32 32Z" fill="currentColor" />
        <path d="M32 4 32 32 25 25Z" fill="currentColor" fill-opacity="0.6" />
        <path d="M39 25 60 32 32 32Z" fill="currentColor" fill-opacity="0.7" />
        <path d="M60 32 39 39 32 32Z" fill="currentColor" fill-opacity="0.3" />
        <path d="M39 39 32 60 32 32Z" fill="currentColor" fill-opacity="0.45" />
        <path d="M32 60 25 39 32 32Z" fill="currentColor" fill-opacity="0.25" />
        <path d="M25 39 4 32 32 32Z" fill="currentColor" fill-opacity="0.6" />
        <path d="M4 32 25 25 32 32Z" fill="currentColor" fill-opacity="0.8" />
      </svg>
    </LogoCard>
  </div>
</section>

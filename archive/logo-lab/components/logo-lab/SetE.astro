---
import LogoCard from './LogoCard.astro';
---
<section id="set-e" class="space-y-6">
  <header>
    <h2 class="font-serif text-2xl">Low-poly · animaux</h2>
    <p class="text-sm text-muted">Des têtes et silhouettes d'animaux en facettes plates, lumière simulée par les opacités : dans l'esprit du renard « Rusé ».</p>
  </header>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
    <LogoCard id="E1" name="Corvus Prism" vibe="Le corbeau de RavenX taillé en facettes, bec acéré, œil rouge." tags={["corbeau", "RavenX", "profil"]}>
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M12 14L34 8L28 28Z" fill="currentColor"/>
        <path d="M34 8L46 22L28 28Z" fill="currentColor" fill-opacity="0.7"/>
        <path d="M46 22L60 36L42 36Z" fill="currentColor" fill-opacity="0.45"/>
        <path d="M28 28L46 22L42 36Z" fill="currentColor" fill-opacity="0.25"/>
        <path d="M12 14L28 28L14 34Z" fill="currentColor" fill-opacity="0.45"/>
        <path d="M14 34L28 28L42 36L30 50Z" fill="currentColor" fill-opacity="0.7"/>
        <path d="M14 34L30 50L10 56Z" fill="currentColor" fill-opacity="0.3"/>
        <circle cx="38" cy="19" r="2.5" fill="#e5383b"/>
      </svg>
    </LogoCard>


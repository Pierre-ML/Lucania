{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions minimales de la fenêtre principale (loader local + pages Astro)",
  "windows": ["main"],
  "remote": { "urls": ["http://localhost:4748", "http://127.0.0.1:4749"] },
  "permissions": [
    "core:default",
    "allow-uninstall-app",
    "allow-app-crash-logs",
    "allow-app-open-crash-logs",
    "allow-engine-info",
    "allow-engine-list-models",
    "allow-engine-status",
    "allow-engine-load",
    "allow-engine-unload",
    "allow-engine-generate",
    "allow-engine-stop",
    "allow-engine-delete-model",
    "allow-hf-search",
    "allow-hf-list-files",
    "allow-hf-download",
    "allow-hf-pause",
    "allow-hf-resume",
    "allow-hf-cancel",
    "allow-hf-list-downloads",
    "allow-hf-token-status",
    "allow-hf-set-token",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "https://*" }] },
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-remove",
    "fs:allow-read-file",
    "fs:allow-write-file",
    { "identifier": "fs:scope", "allow": [{ "path": "$DOCUMENT/Lucania" }, { "path": "$DOCUMENT/Lucania/**" }] },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "explorer-docs", "cmd": "explorer", "args": [{ "validator": "^[A-Za-z]:\\\\Users\\\\[^\\\\]+\\\\Documents\\\\Lucania(\\\\[^\\\\.][^\\\\]*)*$" }] }
      ]
    }
  ]
}
